# OpenAI 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=http://host.docker.internal:8765/v1
OPENAI_MODEL=Deepseek-V4-Flash
# 通义千问等兼容服务可设 false 关闭深度思考；不配置时不传此参数。
# OPENAI_ENABLE_THINKING=false

# MySQL 配置（共享库）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3307
MYSQL_USER=living_stream_agent
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=living_stream_agent

# JWT 密钥（留空则自动生成）
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 应用配置
APP_NAME=living-stream-agent
APP_VERSION=1.0.0
DEBUG=false
APP_ENV=development
APP_PUBLIC_URL=http://127.0.0.1:5172
# 同域 CAS 门户模式，生产使用 http://portal-auth:8080。
PORTAL_AUTH_URL=

# CORS 配置
CORS_ORIGINS=["http://localhost:5172","http://localhost:5173","http://localhost:3000","http://10.131.227.26:5172","http://10.142.238.36:8080","http://10.142.175.197:8080","http://10.142.175.198:8080","http://10.142.175.199:8080","http://10.142.175.200:8080","http://10.142.175.201:8080"]

# 部署配置
# 平台入口校验 Token：平台免登录跳转到本系统时用于校验入口请求合法性。
PLATFORM_ENTRY_TOKEN=
# 手机端 IAM 票据验证：当 platformToken 不等于 PLATFORM_ENTRY_TOKEN 时，将 platformToken 作为 ticket 调用该接口。
IAM_CHECK_TICKET_URL=http://10.142.135.40:80/authn/aisauth/checkTicket
# 手机端 IAM 票据验证 appCode，当前固定为 00001。
IAM_APP_CODE=00001
# IAM 票据验证超时时间：单位秒。
IAM_REQUEST_TIMEOUT_SECONDS=5
# 超级管理员初始密码：首次启动且不存在超级管理员时，用于创建 admin 超级管理员账号。
SUPER_ADMIN_INITIAL_PASSWORD=
# 登录失败次数上限：同一账号或来源在限流窗口内允许失败的最大次数。
AUTH_RATE_LIMIT_MAX_FAILURES=5
# 登录限流统计窗口：单位秒，超过该时间后失败次数重新统计。
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# 登录锁定时长：单位秒，超过失败次数上限后暂时禁止继续登录。
AUTH_LOCK_SECONDS=900
# 单个上传文件最大大小：单位字节，默认 10485760 表示 10MB。
MAX_UPLOAD_BYTES=10485760
# 允许上传的文件扩展名：英文逗号分隔。
ALLOWED_UPLOAD_EXTENSIONS=.txt,.docx,.pdf,.xlsx,.xls

# 本机开发（./start-local）：MySQL 使用 127.0.0.1:3308，模型可接 LM Studio。
# LOCAL_DEV_LOGIN 只由 Vite 开发服务读取，生产构建不包含本地登录入口。
LOCAL_DEV_LOGIN=false
# 使用 compose.local.yml 时设置独立的 MySQL root 密码。
MYSQL_ROOT_PASSWORD=
