#!/bin/bash
# start - 本地开发/修改代码后，重新构建 Docker 镜像并以容器方式启动
# 用法: ./start [--no-build] [--clean]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

NO_BUILD=0
CLEAN=0
for arg in "$@"; do
  case "$arg" in
    --no-build) NO_BUILD=1 ;;
    --clean)    CLEAN=1 ;;
    *)
      echo "未知参数: $arg"
      echo "用法: ./start [--no-build] [--clean]"
      echo "  --no-build  : 跳过镜像构建，直接启动已有容器"
      echo "  --clean     : 先停止并删除容器，再重新启动"
      exit 1
      ;;
  esac
done

echo "=========================================="
echo "直播脚本生成智能体 - 容器启动脚本"
echo "=========================================="

# 检查 Docker
if ! command -v docker &> /dev/null; then
  echo "错误: Docker 未安装，请先安装 Docker"
  exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "错误: Docker Compose 未安装，请先安装 Docker Compose"
  exit 1
fi

# 检查 .env
if [ ! -f .env ]; then
  echo "错误: 未找到 .env 文件，请先创建（可参考 .env.example）"
  exit 1
fi

# 构建前端（vite -> dist），确保前端镜像包含最新代码
if [ "$NO_BUILD" -eq 0 ]; then
  echo ">> 构建前端 (npm run build)..."
  if [ ! -d node_modules ]; then
    echo "   node_modules 不存在，先安装依赖 (npm install)..."
    npm install
  fi
  npm run build
fi

# --clean：停止并删除旧容器，避免旧镜像残留
if [ "$CLEAN" -eq 1 ]; then
  echo ">> 停止并移除旧容器..."
  docker compose down
fi

# 重新构建并启动镜像
if [ "$NO_BUILD" -eq 0 ]; then
  echo ">> 重新构建并启动 Docker 镜像..."
  docker compose up -d --build
else
  echo ">> 直接启动已有容器..."
  docker compose up -d
fi

echo ""
echo "=========================================="
echo "启动完成！"
echo "=========================================="
echo ""
echo "访问地址："
echo "  - 主页面:   http://localhost:5172/chat/"
echo "  - 管理后台: http://localhost:5172/chat/#/config"
echo "  - 超级管理: http://localhost:5172/chat/#/superlogin"
echo ""
echo "查看日志: docker compose logs -f backend"
echo "停止服务: docker compose down"
echo ""
